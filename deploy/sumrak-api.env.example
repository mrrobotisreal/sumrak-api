# Sumrak API environment — copy to /etc/sumrak-api/sumrak-api.env, chmod 600,
# root-owned. NEVER commit a real token or password. Generate a token with:
#   openssl rand -hex 32
# (Variable names keep the SYNCD_ prefix — that is the binary's config API.)

# Required: bearer token the Sumrak app presents for backups
# (Settings → Backup → Home server).
SYNCD_TOKEN=REPLACE_WITH_openssl_rand_hex_32

# Listen address. Loopback only: the public route is the Cloudflare tunnel
# (https://sumrak.winapps.dev → http://localhost:8687). 8687, NOT 8787 —
# :8787 belongs to the aflulit app's syncd on the same box.
SYNCD_ADDR=127.0.0.1:8687

# Where backup archives are stored (systemd's StateDirectory creates it).
SYNCD_DATA_DIR=/var/lib/sumrak-api

# Optional overrides (defaults shown):
# SYNCD_RETENTION_DAYS=30
# SYNCD_MAX_BODY_MB=64

# --- /v1 per-row account sync (T103). Both required to enable /v1.
SYNCD_DATABASE_URL=postgres://sumrak_api:REPLACE_WITH_DB_PASSWORD@127.0.0.1:5432/sumrak_api?sslmode=disable
SYNCD_FIREBASE_PROJECT_ID=sumrak-app
# Max POST /v1/sync/push body in bytes (default 5242880 = 5 MiB):
# SYNCD_MAX_PUSH_BYTES=5242880
