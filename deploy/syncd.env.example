# syncd environment — copy to /etc/syncd/syncd.env, chmod 600, root-owned.
# NEVER commit a real token. Generate one with:
#   openssl rand -hex 32

# Required: bearer token the Sumrak app presents (Settings → Backup → syncd).
SYNCD_TOKEN=REPLACE_WITH_openssl_rand_hex_32

# Listen address. The home server is only reachable over Tailscale, so a
# wildcard bind is fine; pin to the tailnet IP (e.g. 100.x.y.z:8787) for
# extra strictness.
SYNCD_ADDR=:8787

# Where archives are stored (systemd's StateDirectory creates /var/lib/syncd).
SYNCD_DATA_DIR=/var/lib/syncd

# Optional overrides (defaults shown):
# SYNCD_RETENTION_DAYS=30
# SYNCD_MAX_BODY_MB=64

# --- /v1 per-row sync API (T103). Leave both unset to keep syncd backup-only.
# Postgres connection string (placeholders only; real password stays in the
# root-only env file):
# SYNCD_DATABASE_URL=postgres://syncd:REPLACE_WITH_DB_PASSWORD@127.0.0.1:5432/syncd?sslmode=disable
# Firebase project whose ID tokens are accepted (enables /v1):
# SYNCD_FIREBASE_PROJECT_ID=sumrak-app
# Max POST /v1/sync/push body in bytes (default 5242880 = 5 MiB):
# SYNCD_MAX_PUSH_BYTES=5242880
